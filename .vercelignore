# The frontend deploy is a static Expo export. Runtime feature APIs, including
# Google OAuth, live on the canonical private FastAPI backend. Do not package
# duplicate v1 API entrypoints in the web deployment.
api/v1
api/v1/**

# Ignore directories themselves, not just their children. The CLI archive packer
# otherwise treats fully-filtered directories as empty and recursively packs them.
