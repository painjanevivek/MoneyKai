<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Used ONLY by smsReview or explicitly configured review/approved builds. -->
  <uses-permission android:name="android.permission.READ_SMS" tools:node="replace" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="replace" />
  <application>
    <service android:name="com.moneykai.nativecapture.MoneyKaiSmsJobService" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
    <service android:name="com.moneykai.nativecapture.MoneyKaiNotificationListenerService" tools:node="remove" />
    <receiver android:name="com.moneykai.nativecapture.MoneyKaiSmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
      <intent-filter><action android:name="android.provider.Telephony.SMS_RECEIVED" /></intent-filter>
    </receiver>
  </application>
</manifest>
