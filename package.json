{
  "name": "moneykai-monorepo",
  "private": true,
  "workspaces": [
    "apps/MoneyKai-mobile",
    "apps/MoneyKai-web",
    "packages/api-client",
    "packages/domain"
  ],
  "scripts": {
    "start": "npm run mobile:start",
    "web": "npm run web:start",
    "mobile:start": "npm --prefix apps/MoneyKai-mobile run start",
    "mobile:web": "npm --prefix apps/MoneyKai-mobile run web",
    "mobile:android": "npm --prefix apps/MoneyKai-mobile run android",
    "mobile:ios": "npm --prefix apps/MoneyKai-mobile run ios",
    "mobile:lint": "npm --prefix apps/MoneyKai-mobile run lint",
    "mobile:typecheck": "npm --prefix apps/MoneyKai-mobile run typecheck",
    "mobile:test:capture": "npm --prefix apps/MoneyKai-mobile run test:capture",
    "mobile:test:interaction": "npm --prefix apps/MoneyKai-mobile run test:interaction",
    "mobile:verify:release-profile": "node ./scripts/verify-eas-release-profile.mjs",
    "mobile:build": "npm --prefix apps/MoneyKai-mobile run build",
    "mobile:release:android:capture": "npm --prefix apps/MoneyKai-mobile run android:capture:handoff --",
    "mobile:release:android:verify": "npm --prefix apps/MoneyKai-mobile run android:verify:release-permissions --",
    "web:start": "npm --prefix apps/MoneyKai-web run start",
    "web:lint": "npm --prefix apps/MoneyKai-web run lint",
    "web:api-boundary:check": "node ./scripts/verify-canonical-api-boundary.mjs",
    "web:authority-rules:check": "node ./scripts/verify-firestore-authority-rules.mjs",
    "web:typecheck": "npm --prefix apps/MoneyKai-web run typecheck",
    "web:build": "npm --prefix apps/MoneyKai-web run build",
    "api-client:generate": "openapi-typescript ./contracts/openapi/v1.json --output ./packages/api-client/src/schema.d.ts --alphabetize --immutable --export-type --read-write-markers",
    "api-client:check": "npm run api-client:generate -- --check && npm --prefix packages/api-client run typecheck",
    "lint": "npm run mobile:lint && npm run web:lint",
    "typecheck": "npm run mobile:typecheck && npm run web:typecheck",
    "build": "npm run web:build",
    "bootstrap": "npm install --workspaces --include-workspace-root",
    "brand:assets": "node ./scripts/generate-brand-assets.mjs",
    "launch:check": "node ./scripts/launch-check.mjs",
    "release:handoff-baseline": "node ./scripts/verify-handoff-baseline.mjs",
    "release:deployment-preflight": "node ./scripts/deployment-preflight.mjs",
    "release:deployment-preflight:test": "node --test ./scripts/deployment-preflight.test.mjs",
    "seo:generate": "node ./scripts/public-seo.mjs --write",
    "seo:audit": "node ./scripts/public-seo.mjs --audit-dist",
    "seo:geo:audit": "node ./scripts/seo-geo-audit.mjs",
    "security:check": "node ./scripts/owasp-security-check.mjs",
    "security:audit-dependencies": "node ./scripts/audit-npm-dependencies.mjs",
    "security:audit-dependencies:test": "node --test ./scripts/audit-npm-dependencies.test.mjs",
    "security:lockfile-drift": "node ./scripts/verify-lockfile-sync.mjs",
    "security:dependency-manifest:write": "node ./scripts/generate-npm-dependency-manifest.mjs --write",
    "security:dependency-manifest:check": "node ./scripts/generate-npm-dependency-manifest.mjs --check",
    "backup-restore:gate": "node ./scripts/backup-restore-release-gate.mjs",
    "backup-restore:handoff": "node ./scripts/capture-backup-restore-handoff.mjs",
    "indexnow:dry-run": "node ./scripts/indexnow-submit.mjs --dry-run",
    "indexnow:submit": "node ./scripts/indexnow-submit.mjs",
    "backend:dev": "node ./scripts/backend-runner.mjs dev",
    "backend:test": "node ./scripts/backend-runner.mjs test",
    "backend:compile": "node ./scripts/backend-runner.mjs compile",
    "api:test": "node --test api/**/*.test.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "playwright:open": "playwright test --ui",
    "playwright:run": "playwright test",
    "e2e:run": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "browserslist": "4.28.8",
    "cypress": "^15.17.0",
    "openapi-typescript": "7.13.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0"
  },
  "overrides": {
    "@expo/xcpretty": {
      "js-yaml": "4.3.1"
    },
    "@grpc/proto-loader": {
      "protobufjs": "7.6.5"
    },
    "browserslist": "4.28.8"
  }
}
